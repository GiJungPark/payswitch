<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.gijungpark.payswitch.infrastructure.persistence.payment.PaymentMapper">

    <resultMap id="paymentRow" type="io.github.gijungpark.payswitch.infrastructure.persistence.payment.PaymentRow">
        <constructor>
            <idArg column="payment_id" javaType="string"/>
            <arg column="merchant_id" javaType="string"/>
            <arg column="client_reference" javaType="string"/>
            <arg column="approved_amount_minor" javaType="_long"/>
            <arg column="cancelled_amount_minor" javaType="_long"/>
            <arg column="reserved_cancel_amount_minor" javaType="_long"/>
            <arg column="transaction_currency" javaType="string"/>
            <arg column="status" javaType="string"/>
            <arg column="version" javaType="_long"/>
        </constructor>
    </resultMap>

    <sql id="columns">
        payment_id,
        merchant_id,
        client_reference,
        approved_amount_minor,
        cancelled_amount_minor,
        reserved_cancel_amount_minor,
        transaction_currency,
        status,
        version
    </sql>

    <insert id="insert">
        INSERT INTO payment (<include refid="columns"/>)
        VALUES (#{paymentId},
                #{merchantId},
                #{clientReference},
                #{approvedAmountMinor},
                #{cancelledAmountMinor},
                #{reservedCancelAmountMinor},
                #{transactionCurrency},
                #{status},
                #{version})
    </insert>

    <select id="findById" resultMap="paymentRow">
        SELECT <include refid="columns"/>
        FROM payment
        WHERE payment_id = #{paymentId}
    </select>

    <select id="findByMerchantIdAndClientReference" resultMap="paymentRow">
        SELECT <include refid="columns"/>
        FROM payment
        WHERE merchant_id = #{merchantId}
          AND client_reference = #{clientReference}
    </select>
</mapper>
